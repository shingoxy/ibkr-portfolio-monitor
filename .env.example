# IBKR TWS API 连接（本地直连，无需代理）
# 代理 10.10.10.253:7890 在 TWS/IB Gateway 软件中配置
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# 应用服务
APP_HOST=127.0.0.1
APP_PORT=8765
READ_ONLY=true

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/ibkr_portfolio.db

# 日志
LOG_LEVEL=INFO

# 行情类型 (1=实时, 2=冻结, 3=延时)
MARKET_DATA_TYPE=1
